# demo: offline retrieval + verbatim evidence, with no language model.
# openai: cloud embeddings + language model. Sends document chunks to OpenAI.
# ollama: local embeddings + language model via a running Ollama server.
RAG_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_DATABASE=storage/bayan.db
